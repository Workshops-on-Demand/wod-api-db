{
  "name": "server",
  "version": "1.0.2",
  "description": "API server for the Worksops on Demand project",
  "main": "api.js",
  "scripts": {
    "start": "nodemon --exec babel-node --presets @babel/preset-env ./src/api.js",
    "build": "./node_modules/.bin/netlify-lambda build src",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed-data": "npx sequelize db:create && npx sequelize db:migrate && npx sequelize db:seed:all",
    "reset-data": "npx sequelize db:drop && npx sequelize db:create && npx sequelize db:migrate && npx sequelize db:seed:all"
  },
  "keywords": [],
  "author": "WoD team",
  "license": "ISC",
  "dependencies": {
    "@babel/preset-env": "^8.0.7",
    "@sendgrid/mail": "^8.1.6",
    "babel-preset-env": "^1.7.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dotenv": "^18.0.10",
    "dropin-request": "^1.1.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mailchecker": "^6.0.21",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pm2": "^7",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "serverless-http": "^4.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@babel/node": "^8.1.2"
  }
}
